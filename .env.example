# Server Port
PORT=5000

# Vectorize Hindsight API (Optional - operates in SQLite local memory mode if omitted)
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=dealmind

# Groq LLM API (Optional - operates in deterministic engine mode if omitted)
GROQ_API_KEY=

# Local SQLite Database Path
SQLITE_PATH=./data/dealmind.sqlite
