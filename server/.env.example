# DealMind Server — Environment Configuration
# Copy this file to server/.env and fill in your credentials.
# NEVER commit server/.env to version control.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Authentication & Security ────────────────────────────────────────────────
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_your_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
DEFAULT_TENANT_ID=tenant_default

# ─── Groq LLM API (Required for AI recommendations) ──────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=

# ─── Vectorize Hindsight Cloud Memory (Optional) ──────────────────────────────
# If omitted, DealMind operates entirely in SQLite local-memory mode.
# Get your key at: https://vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=dealmind

# ─── Redis Coordination & Caching (Optional) ──────────────────────────────────
# If omitted, DealMind uses an in-process memory fallback — safe for development.
REDIS_URL=redis://127.0.0.1:6379

# ─── Rate Limiting & Token Budget ─────────────────────────────────────────────
TOKEN_BUDGET_GLOBAL=2000000
TOKEN_BUDGET_PER_TENANT=500000
MAX_CONCURRENT_TURNS=5

# ─── SQLite Database Path ─────────────────────────────────────────────────────
SQLITE_PATH=./data/dealmind.sqlite
