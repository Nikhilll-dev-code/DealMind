
# Dependencies
node_modules/
**/node_modules/

# Environment files — allow example templates only
.env
.env.*
!.env.example
!.env.*.example
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Build output
dist/
build/
coverage/

# SQLite databases and runtime files
*.sqlite
*.sqlite3
*.db
*.sqlite-*
*.db-*
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm

# Runtime data — keep the directory placeholder
server/data/*
!server/data/.gitkeep

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Caches and temporary files
.cache/
.parcel-cache/
.turbo/
.vite/
tmp/
temp/

# OS and editor files
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini